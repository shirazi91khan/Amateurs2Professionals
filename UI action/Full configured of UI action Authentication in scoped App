// select same event registry in event name so when event fired then action script trigger
// current is obj mean the msiGR 
if (current && current.isValidRecord()) {// not required but add as to check
    var profileID = event.parm1;
    var loggedUser = event.parm2;
    var logged = JSON.parse(loggedUser);
    
    var oauthGR = new GlideRecord("oauth_credential");
    oauthGR.addQuery("oauth_requestor_profile.oauth_entity_profile", profileID);
    oauthGR.addEncodedQuery('type=refresh_token');
    oauthGR.query();

    if (oauthGR.next()) {
        //get the updated time 
        var updatedOn = new GlideDateTime(oauthGR.getValue('sys_updated_on'));
        // get the current time
        var now = new GlideDateTime();
        // to check how long seconds ago for at 1:00:00 AM is updated time and current time is 1:01:10 so
        diffsecinds will be 70 sec, means updated just 01 minutes and 10 second ago
        var diffSeconds = (now.getNumericValue() - updatedOn.getNumericValue()) / 1000;
        
       //to check if update is before 7 minutes and updated by same as logged user
        if (diffSeconds <= 420 && oauthGR.sys_updated_by == logged.userid) {
            current.work_notes = "MSI originator is " + logged.name;
            current.update();
        } else {
            current.work_notes = "Sorry, Authentication Failed please try again - Click the Open MSI Workspace button";
            current.update();
        }
    } else {
        current.work_notes = "MSI originator failed: No refresh token found.";
        current.update();
    }
}
