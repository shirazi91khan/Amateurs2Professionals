UI action native script 
function authenticateTeams() {
    var record = g_form.getUniqueValue();
    var azureAppClientId = "6b06b312-f271-478f-9614-e5dffd6a4da4";

    // Fetch the dynamic credential sys_id and profile sys_id
    var ga = new GlideAjax('MSIMTeamDynamicAuthentication');
    ga.addParam('sysparm_name', 'getOAuthIds');
    ga.addParam('sysparm_azureid', azureAppClientId);
    ga.getXMLAnswer(function(response) {

        var data = JSON.parse(response);
        var credentialSysid = data.credSysId;
        var profileSysid = data.profileSysId;

        if (!credentialSysid || !profileSysid) {
            g_form.addErrorMessage("Could not find matching OAuth Profile or Credential");
            return;
        }

        var authUrl = '/oauth_initiator.do?oauth_requestor_context=oauth_2_0_credentials&oauth_requestor=' + credentialSysid + '&oauth_provider_profile=' + profileSysid + '&response_type=code';
        g_navigation.openPopup(authUrl); // working	

       // Calling script include to validate the Oauth status is successful or failed
        var ga1 = new GlideAjax('MSIMTeamDynamicAuthentication');
        ga1.addParam('sysparm_name', 'getoauthstatus');
        ga1.addParam('sysparm_profile', profileSysid);
        ga1.addParam('sysparm_record', record);
        ga1.getXMLAnswer(function(answer) {
            g_form.addInfoMessage("Teams authentication is in progress. Background verification scheduled.");
        });

    });
}

