// script include client callable
// to fetch the dynamic the credential and profile sys_id
getOAuthIds: function() {
        var azureId = this.getParameter('sysparm_azureid');
        var result = {};

        var profileGR = new GlideRecord("oauth_entity_profile");
        profileGR.addQuery("oauth_entity.client_id", azureId);
        profileGR.query();
        if (profileGR.next()) {
            result.profileSysId = profileGR.sys_id + '';
        }

        var credGR = new GlideRecord("oauth_2_0_credentials");
        credGR.addQuery("oauth_entity_profile", result.profileSysId);
        credGR.query();
        if (credGR.next()) {
            result.credSysId = credGR.getUniqueValue();
        }
        return JSON.stringify(result);
    },

    // to get oauth status and use of eventscheduled to run the script after few minutes
    getoauthstatus: function() {
        var profilesysID = this.getParameter('sysparm_profile');
        var recordId = this.getParameter('sysparm_record');
        var loggedUser = {};
        loggedUser.userid = gs.getUserName();
        loggedUser.name = gs.getUserDisplayName();
        var logged = JSON.stringify(loggedUser);

        // need to send object of record as msiGR
        var msiGR = new GlideRecord("sn_msi_incident");
        if (msiGR.get(recordId)) {
		    // 2. Set future time for 240 seconds , to send as parameter in eventscheduled to tell when to executes the 
        event 
			  var futureTime = new GlideDateTime();
        futureTime.addSeconds(240); 

        // 3. Queue the event, to fired the event after 240 sec, sysevent.list to check the event 
        is been scheduled to trigger at what time
        // gs.eventQueueScheduled(eventName, record, parm1, parm2, expiration);
        gs.eventQueueScheduled('sn_msi.MSIM.Teams.OAuth.Requested', msiGR, profilesysID, logged, futureTime);
        }
        return "queued"; // Optional: returns a status back to the client if needed
    },

